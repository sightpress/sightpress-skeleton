includes:
    - vendor/sightpress/plugin-core/quality/phpstan-base.neon

parameters:
    paths:
        - src
        - config
        - public
        - tests
        - bin/console
        - importmap.php
    level: max
    tmpDir: var/phpstan
    excludePaths:
        # Generated by Symfony on every container build (config shapes for apps).
        - config/reference.php
