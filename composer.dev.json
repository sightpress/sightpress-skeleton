{
  "name": "sightpress/skeleton",
  "description": "Development set-up: uses the sibling checkouts of plugin-core, core and every official plugin. Run: COMPOSER=composer.dev.json composer install",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "repositories": [
    {
      "type": "path",
      "url": "../plugin-core",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../core",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../plugin-articles",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../plugin-community",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../plugin-forms",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../plugin-newsletter",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../plugin-notifications",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../plugin-image-finder",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../plugin-ai",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../plugin-import",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "sightpress/core": "*@dev",
    "sightpress/plugin-ai": "*@dev",
    "sightpress/plugin-articles": "*@dev",
    "sightpress/plugin-community": "*@dev",
    "sightpress/plugin-core": "dev-main as 1.1.x-dev",
    "sightpress/plugin-forms": "*@dev",
    "sightpress/plugin-image-finder": "*@dev",
    "sightpress/plugin-import": "*@dev",
    "sightpress/plugin-newsletter": "*@dev",
    "sightpress/plugin-notifications": "*@dev",
    "symfony/asset-mapper": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/flex": "^2.5",
    "symfony/runtime": "^8.1"
  },
  "require-dev": {
    "deptrac/deptrac": "^4.0",
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^13.0",
    "rector/rector": "^2.0",
    "symfony/browser-kit": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "bump-after-update": false,
    "allow-plugins": {
      "phpstan/extension-installer": true,
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.0.x-dev"
    },
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "importmap:install": "symfony-cmd"
    },
    "sightpress:install": [
      "Composer\\Config::disableProcessTimeout",
      "@php bin/console sightpress:install --from-composer || exit 0"
    ],
    "post-install-cmd": [
      "@auto-scripts",
      "@sightpress:install"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "test": "phpunit",
    "test:coverage": [
      "XDEBUG_MODE=coverage phpunit --coverage-clover var/coverage/clover.xml",
      "@php vendor/bin/sightpress-check-coverage var/coverage/clover.xml"
    ],
    "stan": "phpstan analyse --memory-limit=1G",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "rector": "rector process --dry-run",
    "deptrac": "deptrac analyse --no-progress",
    "check:licenses": "@php vendor/bin/sightpress-check-licenses",
    "lint:twig": "@php -r \"echo is_dir('templates') ? '' : 'No templates in the skeleton: product templates live in sightpress/core and the plugins. Passed', PHP_EOL; exit(is_dir('templates') ? 1 : 0);\"",
    "qa": [
      "@test:coverage",
      "@stan",
      "@cs",
      "@rector",
      "@deptrac",
      "@lint:twig",
      "@check:licenses",
      "@composer audit"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
