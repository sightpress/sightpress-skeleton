# Defaults for every environment. Never put real secrets in this file: the
# installer writes them to .env.local (development) or to real environment
# variables and *_FILE secrets (production), which override these values.
#
#  * .env                committed defaults
#  * .env.local          this machine's values (not committed)
#  * .env.$APP_ENV       committed defaults for one environment
#  * .env.$APP_ENV.local this machine's values for one environment (not committed)
#
# In production, run "composer dump-env prod" to compile these files.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# The development database from compose.yaml.
DATABASE_URL="postgresql://sightpress:sightpress@127.0.0.1:5432/sightpress?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Mailpit from compose.yaml: read the messages at http://localhost:8025
MAILER_DSN=smtp://127.0.0.1:1025
###< symfony/mailer ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
